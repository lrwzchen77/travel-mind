# Travel Mind local environment example
#
# Copy this file to .env or configure the same values in your IDE / shell.
# Do not commit real API keys, cookies, or runtime_settings.json.

# DeepSeek（OpenAI 兼容，行程规划 / 对话）
AI_OPENAI_API_KEY=your_deepseek_api_key_here
AI_OPENAI_BASE_URL=https://api.deepseek.com
AI_OPENAI_MODEL=deepseek-v4-flash
# 兼容旧变量名（可选，优先用上面 AI_OPENAI_*）
# AI_DASHSCOPE_API_KEY=

AMAP_ENABLED=true
AMAP_KEY=your_amap_web_service_key_here

XHS_ENABLED=false
XHS_MODE=tool
XHS_COOKIE=your_xhs_cookie_here
# Optional. Default uses bundled resources in modules/content/src/main/resources/xhs_sign.
XHS_SIGN_DIR=classpath:xhs_sign

DB_URL=jdbc:mysql://localhost:3306/travelmind?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# Dev-profile bootstrap accounts. Use non-default values outside local demos.
TRAVELMIND_DEMO_PASSWORD=travel123
TRAVELMIND_ADMIN_PASSWORD=admin123

# JWT signing. The value below is local-development only; use a random 32+ byte secret elsewhere.
JWT_SECRET=travelmind-dev-only-jwt-secret-change-me
JWT_TTL_SECONDS=2592000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

PYTHON_AI_BASE_URL=http://localhost:19080
PYTHON_AI_TIMEOUT_MS=10000
# Bundled self-trained TravelRisk-YOLO weights. Clear this value to test rule fallback.
TRAVEL_MIND_YOLO_MODEL=python-ai/models/travel-risk-yolo-best.pt
