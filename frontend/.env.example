# Java API base (proxied in vite for /api as well)
VITE_API_BASE_URL=http://localhost:8080/api

# 地图默认使用项目内精简样式，并从 OpenFreeMap 拉取瓦片（无需 Key）
# 国内生产环境建议部署兼容 /planet 和 /fonts 路径的镜像/CDN：
# VITE_MAP_ASSET_BASE_URL=https://maps.example.cn
# 也可以指定一份完整的国内托管 MapLibre style JSON（优先级更高）：
# VITE_MAP_STYLE_URL=https://maps.example.cn/styles/travelmind.json

# 高德 Key 仅后端 Web 服务需要时可在根目录 .env 配置 AMAP_KEY
# 前端地图已切回 MapLibre，不强制高德 JS Key
